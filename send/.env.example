# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env (it is gitignored).
#   cp .env.example .env
# ============================================================

# ---------- Method 1: Microsoft Graph (recommended) ----------
# From Azure Portal → App registrations → your app
MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=your-client-secret-value
# Mailbox to send FROM
MS_SENDER=parisa.a@gofive.co.th

# ---------- Method 2: SMTP (Office 365) ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=parisa.a@gofive.co.th
SMTP_PASS=your-app-password
SMTP_SENDER=parisa.a@gofive.co.th

# ---------- Shared ----------
EMAIL_SUBJECT=คำขอลบบัญชีของคุณได้รับการอนุมัติ
# Optional default test recipient (used when no CLI arg is given)
TEST_TO=you@example.com
